    {
      "name": "Listado y obtención de IDs reales",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/estudiantes",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const rows = pm.response.json().data;",
              "for (let i = 1; i <= 4; i++) { const row = rows.find(r => r.usuario.email === `estudiante${i}@academica.test`); pm.expect(row).to.exist; pm.collectionVariables.set(`estudiante${i}_id`, row.id); if (i === 1) { pm.collectionVariables.set(\"carrera_id\", row.carrera_id); pm.collectionVariables.set(\"sede_id\", row.sede_id); } }"
            ]
          }
        }
      ]
    },
