meta {
  name: Eliminar estudiante creado
  type: http
  seq: 49
}

delete {
  url: {{base_url}}/estudiantes/{{creado_id}}
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{admin_token}}
}

tests {
  test("HTTP 200", () => expect(res.status).to.equal(200));
}

docs {
  Eliminar estudiante creado

  Envía DELETE {{base_url}}/estudiantes/{{creado_id}}.
  El test espera HTTP 200; una denegación esperada también constituye una prueba aprobada.
  Utiliza el token obtenido en una solicitud anterior. Ejecutar la colección completa en orden.
}
