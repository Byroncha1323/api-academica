meta {
  name: Estudiante no ve registro inactivo ajeno de su carrera
  type: http
  seq: 45
}

get {
  url: {{base_url}}/estudiantes/{{estudiante3_id}}
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{estudiante_token}}
}

tests {
  test("HTTP 403", () => expect(res.status).to.equal(403));
}

docs {
  Estudiante no ve registro inactivo ajeno de su carrera

  Envía GET {{base_url}}/estudiantes/{{estudiante3_id}}.
  El test espera HTTP 403; una denegación esperada también constituye una prueba aprobada.
  Utiliza el token obtenido en una solicitud anterior. Ejecutar la colección completa en orden.
}
