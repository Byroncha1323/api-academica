meta {
  name: Perfil con carrera, sede, roles y permisos
  type: http
  seq: 8
}

get {
  url: {{base_url}}/me
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{profesor_token}}
}

tests {
  test("HTTP 200", () => expect(res.status).to.equal(200));
  test("Rol profesor", () => expect(res.body.user.roles[0].name).to.eql("profesor"));
}

docs {
  Perfil con carrera, sede, roles y permisos

  Envía GET {{base_url}}/me.
  El test espera HTTP 200; una denegación esperada también constituye una prueba aprobada.
  Utiliza el token obtenido en una solicitud anterior. Ejecutar la colección completa en orden.
}
