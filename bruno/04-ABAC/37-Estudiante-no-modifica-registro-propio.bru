meta {
  name: Estudiante no modifica registro propio
  type: http
  seq: 37
}

put {
  url: {{base_url}}/estudiantes/{{estudiante1_id}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{estudiante_token}}
}

body:json {
  {
    "nombre": "No permitido"
  }
}

tests {
  test("HTTP 403", () => expect(res.status).to.equal(403));
}

docs {
  Estudiante no modifica registro propio

  Envía PUT {{base_url}}/estudiantes/{{estudiante1_id}}.
  El test espera HTTP 403; una denegación esperada también constituye una prueba aprobada.
  Utiliza el token obtenido en una solicitud anterior. Ejecutar la colección completa en orden.
  El bloque body:json define los datos enviados; los marcadores entre llaves se resuelven durante la ejecución.
}
