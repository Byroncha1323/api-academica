meta {
  name: ABAC coordinador - misma carrera y sede
  type: http
  seq: 33
}

put {
  url: {{base_url}}/estudiantes/{{estudiante1_id}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{coordinador_token}}
}

body:json {
  {
    "nombre": "Ana María"
  }
}

tests {
  test("HTTP 200", () => expect(res.status).to.equal(200));
}

docs {
  ABAC coordinador - misma carrera y sede

  Envía PUT {{base_url}}/estudiantes/{{estudiante1_id}}.
  El test espera HTTP 200; una denegación esperada también constituye una prueba aprobada.
  Utiliza el token obtenido en una solicitud anterior. Ejecutar la colección completa en orden.
  El bloque body:json define los datos enviados; los marcadores entre llaves se resuelven durante la ejecución.
}
