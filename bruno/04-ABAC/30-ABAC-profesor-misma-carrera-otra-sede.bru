meta {
  name: ABAC profesor - misma carrera, otra sede
  type: http
  seq: 30
}

put {
  url: {{base_url}}/estudiantes/{{estudiante3_id}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{profesor_token}}
}

body:json {
  {
    "nombre": "Ana María"
  }
}

tests {
  test("HTTP 403", () => expect(res.status).to.equal(403));
}

docs {
  ABAC profesor - misma carrera, otra sede

  Envía PUT {{base_url}}/estudiantes/{{estudiante3_id}}.
  El test espera HTTP 403; una denegación esperada también constituye una prueba aprobada.
  Utiliza el token obtenido en una solicitud anterior. Ejecutar la colección completa en orden.
  El bloque body:json define los datos enviados; los marcadores entre llaves se resuelven durante la ejecución.
}
