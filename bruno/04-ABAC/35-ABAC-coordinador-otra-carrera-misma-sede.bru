meta {
  name: ABAC coordinador - otra carrera, misma sede
  type: http
  seq: 35
}

put {
  url: {{base_url}}/estudiantes/{{estudiante4_id}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
  Content-Type: application/json
}

auth:bearer {
  token: {{coordinador_token}}
}

body:json {
  {
    "nombre": "Ana María"
  }
}

tests {
  test("HTTP 403", () => expect(res.status).to.equal(403));
}

docs {
  ABAC coordinador - otra carrera, misma sede

  Envía PUT {{base_url}}/estudiantes/{{estudiante4_id}}.
  El test espera HTTP 403; una denegación esperada también constituye una prueba aprobada.
  Utiliza el token obtenido en una solicitud anterior. Ejecutar la colección completa en orden.
  El bloque body:json define los datos enviados; los marcadores entre llaves se resuelven durante la ejecución.
}
