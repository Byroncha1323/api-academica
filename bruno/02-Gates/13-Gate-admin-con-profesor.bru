meta {
  name: Gate admin con profesor
  type: http
  seq: 13
}

get {
  url: {{base_url}}/admin/dashboard
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{profesor_token}}
}

tests {
  test("HTTP 403", () => expect(res.status).to.equal(403));
}

docs {
  Gate admin con profesor

  Envía GET {{base_url}}/admin/dashboard.
  El test espera HTTP 403; una denegación esperada también constituye una prueba aprobada.
  Utiliza el token obtenido en una solicitud anterior. Ejecutar la colección completa en orden.
}
