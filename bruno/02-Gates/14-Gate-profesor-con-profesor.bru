meta {
  name: Gate profesor con profesor
  type: http
  seq: 14
}

get {
  url: {{base_url}}/profesor/dashboard
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{profesor_token}}
}

tests {
  test("HTTP 200", () => expect(res.status).to.equal(200));
}

docs {
  Gate profesor con profesor

  Envía GET {{base_url}}/profesor/dashboard.
  El test espera HTTP 200; una denegación esperada también constituye una prueba aprobada.
  Utiliza el token obtenido en una solicitud anterior. Ejecutar la colección completa en orden.
}
