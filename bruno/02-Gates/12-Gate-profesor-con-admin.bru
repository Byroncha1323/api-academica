meta {
  name: Gate profesor con admin
  type: http
  seq: 12
}

get {
  url: {{base_url}}/profesor/dashboard
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{admin_token}}
}

tests {
  test("HTTP 403", () => expect(res.status).to.equal(403));
}

docs {
  Gate profesor con admin

  Envía GET {{base_url}}/profesor/dashboard.
  El test espera HTTP 403; una denegación esperada también constituye una prueba aprobada.
  Utiliza el token obtenido en una solicitud anterior. Ejecutar la colección completa en orden.
}
